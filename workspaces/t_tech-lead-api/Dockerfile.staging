FROM node:22-slim

WORKDIR /app

COPY package.json ./
RUN npm ci --only=production

COPY dist/ ./dist/
COPY openapi/ ./openapi/

EXPOSE 3000 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r=>{if(!r.ok)process.exit(1)}).catch(e=>process.exit(1))"

CMD ["node", "dist/index.js"]