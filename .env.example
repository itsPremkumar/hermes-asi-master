# .env — HERMES Advanced — Secrets
# Copy to ~/.hermes/.env and fill real values. NEVER commit .env to git.
# NEVER put secrets in config.yaml — only in .env

# --- Model Provider Keys (set only the one you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=

# --- Optional: Custom Endpoint ---
# BASE_URL=https://...

# --- Optional: Tool-Specific Secrets ---
# GITHUB_TOKEN=          # for repo access
# SEARCH_API_KEY=        # if using custom search provider
# SLACK_TOKEN=           # if messaging_send is enabled
# DISCORD_TOKEN=         # if messaging_send is enabled

# --- Hermes Runtime ---
# HERMES_MODEL=anthropic/claude-sonnet-4
# HERMES_BACKEND=docker
